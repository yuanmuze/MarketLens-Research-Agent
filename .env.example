OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Phase 5 Agent (OpenAI-compatible API)
MARKETLENS_AGENT_API_KEY=
MARKETLENS_AGENT_BASE_URL=https://api.openai.com/v1
MARKETLENS_AGENT_MODEL=gpt-4.1-mini
MARKETLENS_AGENT_TIMEOUT_SECONDS=30
MARKETLENS_AGENT_MAX_STEPS=6
# Deterministic local-only agent provider; never calls an external LLM.
MARKETLENS_USE_FAKE_LLM=false

# Embedding — set to true to use fake embeddings in tests/demos
# (skips ~80MB model download)
MARKETLENS_USE_FAKE_EMBEDDINGS=
MARKETLENS_EMBEDDING_MODEL=all-MiniLM-L6-v2
# memory (default) or pgvector. pgvector requires PostgreSQL and a pre-built
# 384-dimensional index created by scripts/index_product_embeddings.py.
MARKETLENS_SEMANTIC_BACKEND=memory

# Phase 6 Persistence
# Safe local development example (compose default, never use for destructive tests):
# MARKETLENS_DATABASE_URL=postgresql+psycopg2://marketlens:marketlens@localhost:5432/marketlens
# Dedicated integration-test example; the database name must contain "test":
# MARKETLENS_TEST_DATABASE_URL=postgresql+psycopg2://marketlens:marketlens@localhost:5432/marketlens_repo_test
MARKETLENS_DATABASE_URL=
# json (default) loads catalog from JSON file; postgres loads from database
MARKETLENS_CATALOG_BACKEND=json
# Optional explicit JSON path. It is also used as the real embedding cache key
# when a PostgreSQL catalog is paired with the in-memory semantic backend.
MARKETLENS_CATALOG_PATH=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false
