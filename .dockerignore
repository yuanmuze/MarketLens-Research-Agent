# Never copy these into the image
.git
.gitignore
.env
.env.*
.venv
.uv-cache*
.python-*
.claude
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.benchmarks
.coverage
htmlcov
*.egg-info
tmp

# Data / caches / artifacts
data/
*.db
*.sqlite3
data/cache/
data/eval/
data/processed/
reports/
docs/
tests/
*.log

# Docker data (never copy host Docker Desktop WSL dirs)
Docker/
DockerDesktopWSL/
